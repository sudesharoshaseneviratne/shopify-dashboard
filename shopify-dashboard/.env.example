# ==============================================================================
# Prasanthi Craft / Merchant Store & Dashboard Environment Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Connection String
# Get this from your Supabase Project:
#   Project Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# A. Transaction Pooler (RECOMMENDED for Next.js / Vercel Serverless - Port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# B. Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Public Keys (For client-side SDK & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# 3. Cloudflare R2 Storage (10 GB Free Forever, $0 Bandwidth/Egress Fees)
# In Cloudflare Dashboard:
#   1. Go to 'R2' -> Create a bucket (e.g. 'store-products')
#   2. Go to 'R2 API Tokens' -> Create API Token with Object Read & Write permissions
#   3. Enable Public Access on the bucket (or connect your custom domain like 'images.yourdomain.com')
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="store-products"
NEXT_PUBLIC_R2_URL="https://pub-xxxx.r2.dev"


#Push the Tables to Supabase: Run this command in your terminal to create all tables and indexes in your live Supabase database:
#bash
#npm run db:push

#Seed Initial Craft & Stationery Products & Orders:
#bash
#npm run db:seed

#View/Edit Data in Drizzle Studio:
#bash
#npm run db:studio